{
    "name": "infrangible/m2-catalog-product-option-product",
    "description": "New custom option type \"Product\": offer another catalog product, including configurable products with swatches, as a paid add-on on the product page.",
    "type": "magento2-module",
    "version": "2.0.0",
    "license": "MIT",
    "keywords": [
        "Magento",
        "Magento 2",
        "Adobe Commerce",
        "Product options",
        "Catalog",
        "Pricing",
        "products as custom options",
        "add-on products on the product page",
        "upsell products as options"
    ],
    "homepage": "https://www.infrangible.dev/modules/catalog-product-option-product",
    "authors": [
        {
            "name": "Andreas Knollmann",
            "email": "a.knollmann@seak.dev",
            "homepage": "https://www.seak.dev",
            "role": "Developer"
        }
    ],
    "require": {
        "php": ">=8.2",
        "fewedev/base": "~2.4.3",
        "infrangible/m2-catalog-product-option-wrapper": "~2.0.1",
        "infrangible/m2-core": "~5.0.5",
        "infrangible/m2-foundation": "~3.0.1",
        "magento/framework": "~103.0.6",
        "magento/module-catalog": "~104.0.0",
        "magento/module-checkout": "~100.4.0",
        "magento/module-configurable-product": "~100.4.0",
        "magento/module-quote": "~101.2.0",
        "magento/module-sales": "~103.0.0",
        "magento/module-store": "~101.1.0",
        "magento/module-swatches": "~100.4.0",
        "magento/module-tax": "~100.4.0",
        "magento/module-ui": "~101.2.0",
        "psr/log": "~2.0.0||~3.0.0"
    },
    "require-dev": {
        "infrangible/phpstan-magento": "~1.2.0"
    },
    "autoload": {
        "files": [
            "src/registration.php"
        ],
        "psr-4": {
            "Infrangible\\CatalogProductOptionProduct\\": "src"
        }
    }
}
